# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible provider. Leave empty for OpenAI.
#   DeepSeek:   OPENAI_BASE_URL=https://api.deepseek.com      OPENAI_MODEL=deepseek-chat
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1  OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=
